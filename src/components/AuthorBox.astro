---
interface Props {
  name?: string;
  bio?: string;
  role?: string;
  slug?: string;
}

const {
  name = "Aram Anwar",
  role = "Grundare och redaktör",
  bio = "Aram Anwar är grundare och redaktör för Tekniksvar och skriver praktiska guider om teknik, program, AI och digitala tjänster.",
  slug = "aram-anwar"
} = Astro.props;
---

<div style="background-color: var(--color-white); border: 1px solid var(--color-gray-border); border-radius: var(--border-radius); padding: 1.5rem; margin: 2.5rem 0; display: flex; gap: 1.25rem; align-items: flex-start;">
  <div style="width: 56px; height: 56px; border-radius: 50%; background-color: var(--color-navy); color: var(--color-white); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; flex-shrink: 0;">
    AA
  </div>
  <div>
    <h3 style="font-size: 1.1rem; color: var(--color-navy); margin-bottom: 0.2rem;">
      <a href={`/forfattare/${slug}/`} style="color: inherit;">{name}</a>
    </h3>
    <p style="font-size: 0.85rem; color: var(--color-accent); font-weight: 600; margin-bottom: 0.5rem;">{role}</p>
    <p style="font-size: 0.9rem; color: var(--color-gray-dark); margin: 0;">{bio}</p>
  </div>
</div>
