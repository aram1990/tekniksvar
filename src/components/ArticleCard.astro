---
interface Props {
  title: string;
  slug: string;
  description: string;
  topic: string;
  publishedAt: string;
  contentType: string;
  heroImage?: string;
  heroImageAlt?: string;
}

const { title, slug, description, topic, publishedAt, contentType, heroImage, heroImageAlt } = Astro.props;

const topicLabels: Record<string, string> = {
  ai: 'AI & AI-verktyg',
  windows: 'Windows & Datorer',
  android: 'Android & Mobil',
  appar: 'Appar & Webb',
  webb: 'Appar & Webb',
  guider: 'Guider',
  problem: 'Felsökning',
  jamforelser: 'Jämförelser',
};

const typeLabels: Record<string, string> = {
  guide: 'Guide',
  fix: 'Felsökning',
  explanation: 'Förklaring',
  comparison: 'Jämförelse',
  review: 'Recension',
  feature: 'Genomgång',
};
---

<article class="card">
  {heroImage && (
    <a href={`/artiklar/${slug}/`} style="display: block; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background-color: var(--color-navy);">
      <img
        src={heroImage}
        alt={heroImageAlt || title}
        loading="lazy"
        decoding="async"
        style="width: 100%; height: 100%; object-fit: cover; border-top-left-radius: var(--border-radius); border-top-right-radius: var(--border-radius);"
      />
    </a>
  )}
  <div class="card-content">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
      <span class="card-topic">{topicLabels[topic] || topic}</span>
      <span style="font-size: 0.75rem; background: var(--color-gray-bg); padding: 0.15rem 0.5rem; border-radius: 4px; color: var(--color-gray-dark);">{typeLabels[contentType] || contentType}</span>
    </div>
    <h3 class="card-title">
      <a href={`/artiklar/${slug}/`}>{title}</a>
    </h3>
    <p class="card-desc">{description}</p>
    <div class="card-meta">
      <time datetime={publishedAt}>{new Date(publishedAt).toLocaleDateString('sv-SE', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
      <span>•</span>
      <span>Aram Anwar</span>
    </div>
  </div>
</article>
