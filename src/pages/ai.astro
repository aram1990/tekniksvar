---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const aiArticles = await getCollection('articles', ({ data }) => !data.draft && data.topics.includes('ai'));
const sorted = aiArticles.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const breadcrumbs = [{ label: 'AI & AI-verktyg' }];
---

<BaseLayout
  title="AI & AI-verktyg – Guider om ChatGPT & Claude"
  description="Lär dig använda artificiell intelligens i vardagen. Guider, jämförelser och problemlösning för ChatGPT, Claude och generativ AI."
>
  <div style="padding: 2.5rem 0 4rem 0;">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header style="margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--color-navy); margin-bottom: 0.5rem;">
          AI & AI-verktyg
        </h1>
        <p style="font-size: 1.1rem; color: var(--color-gray-dark); max-width: 700px;">
          Förstå hur språkmodeller fungerar, jämför olika AI-tjänster och få praktiska lösningar när ChatGPT sviker.
        </p>
      </header>

      <div class="article-grid">
        {sorted.map((art) => (
          <ArticleCard
            title={art.data.title}
            slug={art.slug}
            description={art.data.description}
            topic="ai"
            publishedAt={art.data.publishedAt}
            contentType={art.data.contentType}
            heroImage={art.data.heroImage}
            heroImageAlt={art.data.heroImageAlt}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
