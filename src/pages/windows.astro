---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const winArticles = await getCollection('articles', ({ data }) => !data.draft && data.topics.includes('windows'));
const sorted = winArticles.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const breadcrumbs = [{ label: 'Windows & Datorer' }];
---

<BaseLayout
  title="Windows & Datorer – Felsökning & Guider"
  description="Lös problem med Wi-Fi, Bluetooth, autostart och tröga datorer i Windows 11. Praktiska instruktioner på svenska."
>
  <div style="padding: 2.5rem 0 4rem 0;">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header style="margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--color-navy); margin-bottom: 0.5rem;">
          Windows & Datorer
        </h1>
        <p style="font-size: 1.1rem; color: var(--color-gray-dark); max-width: 700px;">
          Snabba upp Windows 11, åtgärda nätverksfel och optimera din PC.
        </p>
      </header>

      <div class="article-grid">
        {sorted.map((art) => (
          <ArticleCard
            title={art.data.title}
            slug={art.slug}
            description={art.data.description}
            topic="windows"
            publishedAt={art.data.publishedAt}
            contentType={art.data.contentType}
            heroImage={art.data.heroImage}
            heroImageAlt={art.data.heroImageAlt}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
