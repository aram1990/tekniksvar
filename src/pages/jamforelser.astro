---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const compArticles = await getCollection('articles', ({ data }) => !data.draft && (data.topics.includes('jamforelser') || data.contentType === 'comparison'));
const sorted = compArticles.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const breadcrumbs = [{ label: 'Jämförelser' }];
---

<BaseLayout
  title="Jämförelser – Opartiska jämförelser av program & AI"
  description="Vilken tjänst passar dig bäst? Tydliga och faktabaserade jämförelser mellan populära verktyg och programvara."
>
  <div style="padding: 2.5rem 0 4rem 0;">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header style="margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--color-navy); margin-bottom: 0.5rem;">
          Jämförelser
        </h1>
        <p style="font-size: 1.1rem; color: var(--color-gray-dark); max-width: 700px;">
          "Vilket program eller tjänst passar mig?" Vi jämför funktioner, priser och prestanda på ett tydligt sätt utan dolda betalda rekommendationer.
        </p>
      </header>

      <div class="article-grid">
        {sorted.map((art) => (
          <ArticleCard
            title={art.data.title}
            slug={art.slug}
            description={art.data.description}
            topic={art.data.topics[0] || 'jamforelser'}
            publishedAt={art.data.publishedAt}
            contentType={art.data.contentType}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
