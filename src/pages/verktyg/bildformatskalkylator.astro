---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Verktyg', href: '/verktyg/' },
  { label: 'Bildformatskalkylator' }
];

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Bildformatskalkylator — Tekniksvar",
  "url": "https://tekniksvar.com/verktyg/bildformatskalkylator/",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "inLanguage": "sv-SE",
  "description": "Räkna ut bildförhållande (aspect ratio) och beräkna nya dimensioner i pixlar för digitala bilder och videoklipp."
};
---

<BaseLayout
  title="Bildformatskalkylator – Beräkna aspect ratio och bildstorlek"
  description="Gratis kalkylator för aspect ratio (bildförhållande). Beräkna bredd och höjd för 16:9, 4:3, 1:1, 9:16 med exakta pixelvärden."
>
  <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />

  <div style="padding: 2.5rem 0 4rem 0;">
    <div class="content-container">
      <Breadcrumbs items={breadcrumbs} />

      <header style="margin-bottom: 2rem;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--color-navy); margin-bottom: 0.75rem;">
          Bildformatskalkylator
        </h1>
        <p style="font-size: 1.1rem; color: var(--color-gray-dark);">
          Beräkna exakta dimensioner i pixlar utifrån önskat bildförhållande (aspect ratio) som 16:9, 4:3 eller 1:1.
        </p>
      </header>

      <!-- Tool UI -->
      <div style="background: var(--color-white); border: 1px solid var(--color-gray-border); border-radius: var(--border-radius); padding: 1.5rem; box-shadow: var(--shadow-sm); margin-bottom: 2.5rem;">

        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-navy);">Välj förinställt bildförhållande:</label>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            <button class="preset-btn" data-ratio-w="16" data-ratio-h="9" style="padding: 0.4rem 0.85rem; border: 1px solid var(--color-gray-border); background: var(--color-gray-bg); border-radius: 4px; font-weight: 600; cursor: pointer;">16:9 (Widescreen / TV)</button>
            <button class="preset-btn" data-ratio-w="4" data-ratio-h="3" style="padding: 0.4rem 0.85rem; border: 1px solid var(--color-gray-border); background: var(--color-gray-bg); border-radius: 4px; font-weight: 600; cursor: pointer;">4:3 (Klassisk skärm)</button>
            <button class="preset-btn" data-ratio-w="1" data-ratio-h="1" style="padding: 0.4rem 0.85rem; border: 1px solid var(--color-gray-border); background: var(--color-gray-bg); border-radius: 4px; font-weight: 600; cursor: pointer;">1:1 (Kvadrat / Instagram)</button>
            <button class="preset-btn" data-ratio-w="9" data-ratio-h="16" style="padding: 0.4rem 0.85rem; border: 1px solid var(--color-gray-border); background: var(--color-gray-bg); border-radius: 4px; font-weight: 600; cursor: pointer;">9:16 (Vertikal / Stories / TikTok)</button>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div>
            <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--color-navy);">Förhållande Bredd (Ratio W):</label>
            <input type="number" id="ratio-w" value="16" min="1" style="width: 100%; padding: 0.6rem; border: 1px solid var(--color-gray-border); border-radius: 4px; font-size: 1rem;" />
          </div>
          <div>
            <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 0.35rem; color: var(--color-navy);">Förhållande Höjd (Ratio H):</label>
            <input type="number" id="ratio-h" value="9" min="1" style="width: 100%; padding: 0.6rem; border: 1px solid var(--color-gray-border); border-radius: 4px; font-size: 1rem;" />
          </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--color-gray-border); margin: 1.5rem 0;" />

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
          <div>
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--color-navy);">Bredd (pixlar):</label>
            <input type="number" id="pixel-w" value="1920" style="width: 100%; padding: 0.6rem; border: 1px solid var(--color-accent); border-radius: 4px; font-size: 1.1rem; font-weight: 600;" />
          </div>
          <div>
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.35rem; color: var(--color-navy);">Höjd (pixlar):</label>
            <input type="number" id="pixel-h" value="1080" style="width: 100%; padding: 0.6rem; border: 1px solid var(--color-accent); border-radius: 4px; font-size: 1.1rem; font-weight: 600;" />
          </div>
        </div>

      </div>

      <!-- Explanatory Guide -->
      <section style="line-height: 1.7; color: var(--color-slate);">
        <h2 style="font-size: 1.5rem; color: var(--color-navy); margin-bottom: 1rem;">Vad är aspect ratio (bildförhållande)?</h2>
        <p style="margin-bottom: 1rem;">
          Aspect ratio anger det proportionella förhållandet mellan en bilds bredd och höjd. Det skrivs vanligen som två siffror separerade med ett kolontecken, exempelvis <strong>16:9</strong>. Det betyder att för varje 16 enheter i bredd är bilden 9 enheter hög.
        </p>

        <h3 style="font-size: 1.2rem; color: var(--color-navy); margin: 1.5rem 0 0.5rem 0;">Vanliga standarder för bild och video</h3>
        <ul style="padding-left: 1.25rem; margin-bottom: 1rem;">
          <li>**16:9 (Widescreen):** Standard för YouTube, HD-TV, datorskärmar och modern video (t.ex. 1920x1080, 2560x1440, 3840x2160).</li>
          <li>**9:16 (Vertikal video):** Används för mobila format som TikTok, Instagram Reels och YouTube Shorts (t.ex. 1080x1920).</li>
          <li>**1:1 (Kvadrat):** Klassiskt format för Instagram-flödet och profilbilder (t.ex. 1080x1080).</li>
          <li>**4:3 (Klassiskt):** Standard för äldre TV-apparater och iPad-skärmar (t.ex. 1024x768).</li>
        </ul>
      </section>
    </div>
  </div>

  <script>
    const ratioWInput = document.getElementById('ratio-w') as HTMLInputElement;
    const ratioHInput = document.getElementById('ratio-h') as HTMLInputElement;
    const pixelWInput = document.getElementById('pixel-w') as HTMLInputElement;
    const pixelHInput = document.getElementById('pixel-h') as HTMLInputElement;
    const presetBtns = document.querySelectorAll('.preset-btn');

    function updateFromWidth() {
      const rw = parseFloat(ratioWInput.value) || 1;
      const rh = parseFloat(ratioHInput.value) || 1;
      const pw = parseFloat(pixelWInput.value) || 0;
      pixelHInput.value = Math.round((pw * rh) / rw).toString();
    }

    function updateFromHeight() {
      const rw = parseFloat(ratioWInput.value) || 1;
      const rh = parseFloat(ratioHInput.value) || 1;
      const ph = parseFloat(pixelHInput.value) || 0;
      pixelWInput.value = Math.round((ph * rw) / rh).toString();
    }

    pixelWInput?.addEventListener('input', updateFromWidth);
    pixelHInput?.addEventListener('input', updateFromHeight);
    ratioWInput?.addEventListener('input', updateFromWidth);
    ratioHInput?.addEventListener('input', updateFromWidth);

    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const w = btn.getAttribute('data-ratio-w')!;
        const h = btn.getAttribute('data-ratio-h')!;
        ratioWInput.value = w;
        ratioHInput.value = h;
        updateFromWidth();
      });
    });
  </script>
</BaseLayout>
