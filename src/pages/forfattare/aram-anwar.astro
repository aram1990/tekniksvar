---
import PageLayout from '../../layouts/PageLayout.astro';

const breadcrumbs = [
  { label: 'Författare', href: '/forfattare/' },
  { label: 'Aram Anwar' }
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Aram Anwar",
  "url": "https://tekniksvar.com/forfattare/aram-anwar/",
  "jobTitle": "Grundare och redaktör",
  "worksFor": {
    "@type": "Organization",
    "name": "Tekniksvar",
    "url": "https://tekniksvar.com"
  },
  "description": "Aram Anwar är grundare och redaktör för Tekniksvar och skriver praktiska guider om teknik, program, AI och digitala tjänster."
};
---

<PageLayout
  title="Aram Anwar – Grundare och redaktör"
  description="Läs mer om Aram Anwar, grundare och redaktör för Tekniksvar. Skriver praktiska guider och problemlösning om teknik."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <div style="background: var(--color-white); border: 1px solid var(--color-gray-border); border-radius: var(--border-radius); padding: 2rem; margin-bottom: 2rem;">
    <div style="display: flex; gap: 1.5rem; align-items: center; margin-bottom: 1.5rem;">
      <div style="width: 72px; height: 72px; border-radius: 50%; background-color: var(--color-navy); color: var(--color-white); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.75rem;">
        AA
      </div>
      <div>
        <h2 style="font-size: 1.5rem; color: var(--color-navy); margin-bottom: 0.2rem;">Aram Anwar</h2>
        <p style="color: var(--color-accent); font-weight: 600; margin: 0;">Grundare & Redaktör</p>
      </div>
    </div>

    <p style="font-size: 1.05rem; line-height: 1.7; color: var(--color-slate); margin-bottom: 1.25rem;">
      Aram Anwar är grundare och redaktör för Tekniksvar och skriver praktiska guider om teknik, program, AI och digitala tjänster.
    </p>

    <p style="font-size: 1rem; line-height: 1.7; color: var(--color-gray-dark);">
      Fokuset ligger på att förklara komplicerade tekniska frågor på ett enkelt och förståeligt sätt utan onödiga facktermer eller vilseledande påståenden. Alla artiklar skrivs med målet att ge läsaren en direkt lösning på ett konkret problem.
    </p>
  </div>
</PageLayout>
