---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const problemArticles = await getCollection('articles', ({ data }) => !data.draft && (data.topics.includes('problem') || data.contentType === 'fix'));
const sorted = problemArticles.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const breadcrumbs = [{ label: 'Felsökning & Problem' }];
---

<BaseLayout
  title="Felsökning & Teknikproblem – Tekniksvar"
  description="Steg för steg-guider för att lösa vanliga teknikproblem i Windows 11, Android och populära AI-tjänster."
>
  <div style="padding: 2.5rem 0 4rem 0;">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header style="margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--color-navy); margin-bottom: 0.5rem;">
          Felsökning & Teknikproblem
        </h1>
        <p style="font-size: 1.1rem; color: var(--color-gray-dark); max-width: 700px;">
          "Jag har ett teknikproblem. Hjälp mig lösa det." Här samlar vi raka och lösningsorienterade guider när prylar och program krånglar.
        </p>
      </header>

      <div class="article-grid">
        {sorted.map((art) => (
          <ArticleCard
            title={art.data.title}
            slug={art.slug}
            description={art.data.description}
            topic={art.data.topics[0] || 'problem'}
            publishedAt={art.data.publishedAt}
            contentType={art.data.contentType}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
